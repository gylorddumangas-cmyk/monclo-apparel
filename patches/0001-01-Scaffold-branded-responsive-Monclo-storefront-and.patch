+"""PyScript client. All dynamic interactions live in Python, not JavaScript."""
+from pyscript import document
+
+
+def render_home():
+    document.getElementById("page-content").innerHTML = """
+      <section class="hero"><div class="container hero-inner"><div class="hero-copy"><span class="hero-kicker">MONCLO APPAREL · EST. 2026</span><h1>Wear Your Style.<br><em>Define Your Identity.</em></h1><p>Discover modern essentials and everyday streetwear designed to express your individuality.</p><a class="btn" href="#/shop">EXPLORE THE COLLECTION <span>↗</span></a></div><div class="hero-visual"><img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?w=1000&q=85&fit=crop" alt="Contemporary streetwear fashion editorial"></div></div></section>
+      <div class="container benefit-row"><div class="benefit-mini"><span>✦</span> EVERYDAY ESSENTIALS</div><div class="benefit-mini"><span>◇</span> CURATED FOR COMFORT</div><div class="benefit-mini"><span>↗</span> CASH ON DELIVERY</div></div>
