# Configure in your hosting environment. Never commit real secrets.
MONCLO_DB=instance/monclo.db
MONCLO_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
MONCLO_ADMIN_USERNAME=admin
MONCLO_ADMIN_PASSWORD=replace-with-a-strong-unique-password
MONCLO_CONTACT_EMAIL=contact@your-real-domain.example
MONCLO_INSTAGRAM_URL=https://www.instagram.com/yourbrand/
MONCLO_HTTPS=0
PORT=5000
